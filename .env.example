# Local development environment variables for gotranslate.
# Copy this file to .env and fill in your credentials.
# .env files are never committed; production should inject env vars directly.

GOTRANSLATE_PROVIDER=anthropic
GOTRANSLATE_MODEL=claude-sonnet-4-6
GOTRANSLATE_FROM=auto
GOTRANSLATE_TO=English

# Provider credentials (the config file stores env var names, not the keys themselves)
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
OPENROUTER_API_KEY=...
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
