# Local development environment variables for aitranslate.
# Copy this file to .env and fill in your credentials.
# .env files are never committed; production should inject env vars directly.

AITRANSLATE_PROVIDER=anthropic
AITRANSLATE_MODEL=claude-sonnet-4-6
AITRANSLATE_FROM=auto
AITRANSLATE_TO=English

# Provider credentials (the config file stores env var names, not the keys themselves)
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
OPENROUTER_API_KEY=...
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
